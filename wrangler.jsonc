/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "what-can-browser-run-do",
	// Browser Run `.quickAction()` requires a compatibility date of 2026-03-24 or later.
	"compatibility_date": "2026-06-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@tanstack/react-start/server-entry",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// Browser Run (formerly Browser Rendering) binding.
	// `remote: true` is REQUIRED for Quick Actions during local dev - they run
	// against the real headless browser over Cloudflare's network, not a local
	// stub. Without it you'll see: RPC receiver does not implement "quickAction".
	"browser": {
		"binding": "BROWSER",
		"remote": true
	},
	// D1 (SQLite) database. `migrations_dir` MUST point at "drizzle" so that
	// `wrangler d1 migrations apply DB` finds the SQL generated by drizzle-kit.
	// Without this, wrangler looks in the default ./migrations folder and fails
	// with "No migrations present at .../migrations".
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "what-can-browser-run-do-db",
			"database_id": "4d40ad13-ba27-4d71-9fe5-c1d72a58f2e5",
			"migrations_dir": "drizzle"
		}
	],
	// R2 bucket for object/file storage (see src/routes/api/files.ts).
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "what-can-browser-run-do-storage"
		}
	],
	// KV namespace used to cache extracted brand kits so repeat lookups of the
	// same URL are instant (and don't re-spend Browser Run / Workers AI).
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "7a311e5bb43d498290eb1adff9188b56"
		}
	]
}